# ============================================================================
# Environment Variables - opsforce.ai
# ============================================================================
# Copy this file to .env.local and fill in the actual values
# This template documents all required and optional configuration
# ============================================================================

# ============================================================================
# Core Configuration
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# Database
# ============================================================================
# MySQL connection string
# Format: mysql://username:password@host:port/database
# Example: mysql://root:password@localhost:3306/opsforce_ai
DATABASE_URL=mysql://root:password@localhost:3306/opsforce_ai

# ============================================================================
# Authentication & Session
# ============================================================================
# Strong random string for signing JWT session tokens
# Generate with: openssl rand -base64 32
# MUST be kept secret and consistent across deployments
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# OAuth App Configuration
# These values are provided by Manus OAuth Server during app registration
VITE_APP_ID=your-oauth-app-id
OAUTH_SERVER_URL=https://oauth.manus.im

# First admin user - Manus openId
# Users with this openId will automatically be assigned 'admin' role
# Leave empty if not using Manus authentication
OWNER_OPEN_ID=your-manus-user-open-id

# OAuth login portal (client-side configuration)
# Where users are redirected to log in
VITE_OAUTH_PORTAL_URL=https://oauth.manus.im

# ============================================================================
# AI & LLM Services (Optional - Manus Forge API by default)
# ============================================================================
# Override default LLM endpoint (defaults to https://forge.manus.im/v1/chat/completions)
# Can be configured to use OpenAI, Claude, or other compatible APIs
# Leave blank to use default Manus Forge API
# BUILT_IN_FORGE_API_URL=https://forge.manus.im

# LLM API key for authentication
# Required if using LLM features (voice transcription, image generation, etc.)
# BUILT_IN_FORGE_API_KEY=your-api-key-here

# ============================================================================
# AWS S3 Configuration (Optional - For file uploads)
# ============================================================================
# AWS credentials for S3 access (presigned URLs for uploads)
# Leave empty if not using file upload features
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# ============================================================================
# Google Maps (Optional - Types included, not yet integrated)
# ============================================================================
# Google Maps API key if implementing map features
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================================================
# Development Tools (Optional)
# ============================================================================
# Note: Manus debug collector creates .manus-logs/ directory
# These logs are for development debugging only; not needed in production
